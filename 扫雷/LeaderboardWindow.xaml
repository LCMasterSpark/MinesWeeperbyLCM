<Window x:Class="扫雷.LeaderboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:扫雷"
        mc:Ignorable="d"
        Title="扫雷 - 排行榜" Height="560" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="排行榜"
                   FontSize="34"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12"/>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D7DEE2"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="MvpText"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#34495E"
                           TextAlignment="Center"/>
                <TextBlock Text="按总分排序；同分时依次比较胜局、胜率和最近游玩时间。"
                           FontSize="12"
                           Foreground="#7F8C8D"
                           TextAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="LeaderboardGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="排名" Binding="{Binding Rank}" Width="60"/>
                <DataGridTextColumn Header="玩家" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="总分" Binding="{Binding TotalScore}" Width="90"/>
                <DataGridTextColumn Header="局数" Binding="{Binding GamesPlayed}" Width="70"/>
                <DataGridTextColumn Header="胜局" Binding="{Binding Wins}" Width="70"/>
                <DataGridTextColumn Header="胜率" Binding="{Binding WinRateText}" Width="80"/>
                <DataGridTextColumn Header="普通" Binding="{Binding ClassicGames}" Width="70"/>
                <DataGridTextColumn Header="街机" Binding="{Binding ArcadeGames}" Width="70"/>
                <DataGridTextColumn Header="最近游玩" Binding="{Binding LastPlayedText}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="3"
                Content="关闭"
                HorizontalAlignment="Center"
                FontSize="15"
                Padding="24,9"
                Margin="0,16,0,0"
                Background="#3498DB"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
