<Window x:Class="扫雷.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:扫雷"
        mc:Ignorable="d"
        Title="扫雷" Height="600" Width="650">
    <DockPanel Background="#ECF0F1" Margin="10">
        <Border DockPanel.Dock="Top"
                Background="White"
                BorderBrush="#D7DEE2"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock x:Name="StatusText"
                               Text="左键揭开方块，右键标记地雷。普通模式第一步不会踩雷。"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#34495E"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="FlagText"
                               Text="已标记：0"
                               FontSize="12"
                               Foreground="#7F8C8D"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button x:Name="MenuButton"
                        Grid.Column="1"
                        Content="返回开始菜单"
                        MinWidth="110"
                        Padding="12,8"
                        VerticalAlignment="Center"
                        Background="#3498DB"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="MenuButton_Click"/>
            </Grid>
        </Border>

        <Border Background="White" CornerRadius="12" Padding="12" BorderBrush="#BDC3C7" BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="GameGrid" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
